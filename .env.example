# ─── JWT ───────────────────────────────────────────────
JWT_SECRET=change_me_in_production

# ─── Database mode ─────────────────────────────────────
# Set to true  → all services connect to Supabase via DATABASE_URL
# Set to false → all services connect to the local Docker postgres container
USE_SUPABASE=false

# ─── Supabase (only needed when USE_SUPABASE=true) ─────
# Get this from: Supabase dashboard → Project Settings → Database → Connection string (URI mode)
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ─── Local Docker postgres (only needed when USE_SUPABASE=false) ───
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=hotelzilla
